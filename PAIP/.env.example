# ============================================================
# PAIP — Environment Variables
# ============================================================
# Copy file này thành .env rồi điền API keys

# --- App ---
APP_NAME=PAIP
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# --- Obsidian Vault Path (để sync prompts, specs) ---
OBSIDIAN_VAULT_PATH=d:/AI_R&D/PTSC_AI_RnD

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# --- Google Gemini ---
GOOGLE_API_KEY=your-key-here
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=your-key-here
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-20250514

# --- Default LLM Provider ---
# Options: openai, gemini, claude
DEFAULT_LLM_PROVIDER=openai

# --- Cost Limits ---
MONTHLY_COST_LIMIT_USD=50.0
ALERT_THRESHOLD_USD=40.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/paip.log

# --- Database & Persistence ---
# Dev: sqlite+aiosqlite:///./data/paip.db
# Prod: postgresql+asyncpg://postgres:password@localhost:5432/paip_db
DATABASE_URL=sqlite+aiosqlite:///./data/paip.db
DB_ECHO_SQL=false
